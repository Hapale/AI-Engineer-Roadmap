from transformers import AutoTokenizer, AutoModelForSequenceClassification

model_name = "distilbert-base-uncased-finetuned-sst-2-english"

print("در حال دانلود و ذخیره مدل روی کامپیوتر شما... (فقط همین یک‌بار نیاز به اینترنت است)")

# دانلود بخش‌های اصلی مدل
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForSequenceClassification.from_pretrained(model_name)

# ذخیره مدل در یک پوشه محلی (Local)
tokenizer.save_pretrained("./my_local_transformer")
model.save_pretrained("./my_local_transformer")

print("مدل با موفقیت به صورت لوکال ذخیره شد!")
